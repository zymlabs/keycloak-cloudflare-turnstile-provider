<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="cloudflare-turnstile-1.0.0" author="zymlabs">
        <createTable tableName="cloudflare_turnstile_check">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="VARCHAR(36)">
                <constraints nullable="true"/>
            </column>
            <column name="realm_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="ip_address" type="VARCHAR(45)">
                <constraints nullable="false"/>
            </column>
            <column name="timestamp" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="success" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="error_codes" type="VARCHAR(500)">
                <constraints nullable="true"/>
            </column>
            <column name="challenge_ts" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
            <column name="hostname" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="event_id" type="VARCHAR(36)">
                <constraints nullable="true"/>
            </column>
            <column name="session_id" type="VARCHAR(36)">
                <constraints nullable="true"/>
            </column>
            <column name="raw_response" type="TEXT">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <createIndex indexName="idx_turnstile_user_id" tableName="cloudflare_turnstile_check">
            <column name="user_id"/>
        </createIndex>

        <createIndex indexName="idx_turnstile_realm_id" tableName="cloudflare_turnstile_check">
            <column name="realm_id"/>
        </createIndex>

        <createIndex indexName="idx_turnstile_timestamp" tableName="cloudflare_turnstile_check">
            <column name="timestamp"/>
        </createIndex>

        <createIndex indexName="idx_turnstile_user_timestamp" tableName="cloudflare_turnstile_check">
            <column name="user_id"/>
            <column name="timestamp"/>
        </createIndex>

        <createIndex indexName="idx_turnstile_event_id" tableName="cloudflare_turnstile_check">
            <column name="event_id"/>
        </createIndex>

        <createIndex indexName="idx_turnstile_session_id" tableName="cloudflare_turnstile_check">
            <column name="session_id"/>
        </createIndex>
    </changeSet>

    <!-- Add audit columns for comprehensive tracking of configuration and outcomes -->
    <changeSet id="cloudflare-turnstile-1.1.0" author="zymlabs">
        <!-- Add flow_type column (was missing from initial schema but needed in entity) -->
        <addColumn tableName="cloudflare_turnstile_check">
            <column name="flow_type" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <!-- Add configuration context columns -->
        <addColumn tableName="cloudflare_turnstile_check">
            <column name="fail_mode" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <addColumn tableName="cloudflare_turnstile_check">
            <column name="fail_action" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <addColumn tableName="cloudflare_turnstile_check">
            <column name="allowlist_behavior" type="VARCHAR(30)">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <addColumn tableName="cloudflare_turnstile_check">
            <column name="implementation_method" type="VARCHAR(30)">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <!-- Add IP processing status columns -->
        <addColumn tableName="cloudflare_turnstile_check">
            <column name="ip_allowlisted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <addColumn tableName="cloudflare_turnstile_check">
            <column name="ip_blocklisted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <addColumn tableName="cloudflare_turnstile_check">
            <column name="verification_skipped" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <!-- Add final outcome columns -->
        <addColumn tableName="cloudflare_turnstile_check">
            <column name="authentication_allowed" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <addColumn tableName="cloudflare_turnstile_check">
            <column name="action_reason" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <!-- Create indexes for new audit columns -->
        <createIndex indexName="idx_turnstile_flow_type" tableName="cloudflare_turnstile_check">
            <column name="flow_type"/>
        </createIndex>

        <createIndex indexName="idx_turnstile_auth_allowed" tableName="cloudflare_turnstile_check">
            <column name="authentication_allowed"/>
        </createIndex>

        <createIndex indexName="idx_turnstile_fail_mode" tableName="cloudflare_turnstile_check">
            <column name="fail_mode"/>
        </createIndex>

        <createIndex indexName="idx_turnstile_fail_action" tableName="cloudflare_turnstile_check">
            <column name="fail_action"/>
        </createIndex>

        <createIndex indexName="idx_turnstile_ip_allowlisted" tableName="cloudflare_turnstile_check">
            <column name="ip_allowlisted"/>
        </createIndex>

        <createIndex indexName="idx_turnstile_verification_skipped" tableName="cloudflare_turnstile_check">
            <column name="verification_skipped"/>
        </createIndex>

        <createIndex indexName="idx_turnstile_action_reason" tableName="cloudflare_turnstile_check">
            <column name="action_reason"/>
        </createIndex>

        <!-- Composite index for outcome analysis queries -->
        <createIndex indexName="idx_turnstile_outcome_analysis" tableName="cloudflare_turnstile_check">
            <column name="realm_id"/>
            <column name="authentication_allowed"/>
            <column name="success"/>
            <column name="timestamp"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
